# Copy to tallyveda.env (same folder), fill in, chmod 600. Never commit tallyveda.env.

# Keep using Neon (recommended to start): the same value as on Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Only seed the first bank / platform logins of an EMPTY database; ignored once
# any tenant exists (so for Neon they change nothing). Still required to start.
TC_ADMIN_USER=
TC_ADMIN_PASSWORD=
TC_PLATFORM_ADMIN_USER=
TC_PLATFORM_ADMIN_PASSWORD=
TC_BANK_NAME=Demo Bank

# The public address of this server (no trailing slash).
TC_PUBLIC_URL=https://tallyveda.duckdns.org

# Copy the rest from Render's Environment tab if you use them there:
# TC_SMTP_HOST= TC_SMTP_PORT=465 TC_SMTP_USER= TC_SMTP_PASSWORD= TC_SMTP_FROM=
# TC_REQUIRE_OTP=1  TC_CONNECTOR_URL=  TC_OPERATOR_NAME=  TC_OPERATOR_ADDRESS=  TC_GRIEVANCE_EMAIL=

# MATTR AI bridge (leave empty to keep it off).
TC_N8N_WEBHOOK_URL=https://tally-bot.duckdns.org/webhook/mattr-bridge
TC_N8N_WEBHOOK_SECRET=
TC_ALERT_EMAIL=
